# API
APP_NAME=A:SESSION API
APP_ENV=dev
APP_PORT=8000

# Postgres
POSTGRES_DB=asession
POSTGRES_USER=asession
POSTGRES_PASSWORD=asession
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# MinIO (S3-compatible)
MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_SECURE=false
MINIO_BUCKET_AUDIO=a-session-audio
MINIO_BUCKET_SCORE=a-session-score

# CORS (comma separated)
CORS_ORIGINS=*
